{{- define "t"}}{{if eq .VI .EN}}{{.EN}}{{else}}<span lang="vi">{{.VI}}</span><span lang="en">{{.EN}}</span>{{end}}{{end -}}
{{- define "p"}}{{if eq .VI .EN}}<p>{{.EN}}</p>{{else}}<p lang="vi">{{.VI}}</p><p lang="en">{{.EN}}</p>{{end}}{{end -}}
{{- define "copylbl"}}<span class="lbl">{{template "t" .}}</span><span class="done">{{template "t" (L "copied")}}</span>{{end -}}
{{- define "fix"}}{{with .Prose}}<span class="fprose">{{.}}</span>{{end}}{{with .Cmd}}<div class="cmd"><code>{{.}}</code><button type="button" class="btn noprint" data-copy-cmd>{{template "copylbl" (L "copy")}}</button></div>{{end}}{{end -}}
{{- define "tile"}}<span class="badge" aria-hidden="true">{{.Mark}}</span><span class="tname">{{template "t" .Name}}</span><span class="tstat">{{template "t" .Status}}</span>{{end -}}
<!DOCTYPE html>
<html lang="{{.Lang}}" data-lang="{{.Lang}}" data-title-vi="{{.TitleVI}}" data-title-en="{{.TitleEN}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="generator" content="Diagward {{.Version}}">
<title>{{if eq .Lang "vi"}}{{.TitleVI}}{{else}}{{.TitleEN}}{{end}}</title>
<script>try{var dwt=localStorage.getItem("dw-theme");if(dwt==="dark"||dwt==="light"){document.documentElement.setAttribute("data-theme",dwt);}}catch(e){}</script>
<style>
:root{
--bg:#FAF9F5;--surface:#F5F4EE;--text:#1F1E1D;--muted:#6B6A65;--border:#E8E6DC;--accent:#C96442;--accent-ink:#FFFFFF;--code-bg:#EEECE3;
--crit:#B3261E;--crit-bg:#FBECE8;--crit-bd:#EDC2B9;
--warn:#8F5B00;--warn-bg:#FBF1DC;--warn-bd:#EBD39F;
--ok:#2F6B3F;--ok-bg:#E9F2E7;--ok-bd:#C3DABF;
--info:#3D5D7C;--info-bg:#E9EFF5;--info-bd:#C5D3E1;
--none:#7A7871;--none-bg:#EFEEE8;--none-bd:#DDDBD2;
--badge-ink:#FFFFFF;
--serif:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;
--sans:system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
--mono:ui-monospace,"Cascadia Mono","SF Mono",Menlo,Consolas,"Liberation Mono",monospace;
color-scheme:light;
}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]){
--bg:#1F1E1D;--surface:#2A2927;--text:#ECEAE4;--muted:#A8A59C;--border:#3A3935;--accent:#D97757;--accent-ink:#1F1E1D;--code-bg:#242321;
--crit:#F2A08F;--crit-bg:#3B221D;--crit-bd:#6B3A30;
--warn:#E9C06B;--warn-bg:#372C17;--warn-bd:#66522A;
--ok:#97CE9F;--ok-bg:#1F3124;--ok-bd:#3A5A40;
--info:#A7C2DC;--info-bg:#1F2B37;--info-bd:#3B5268;
--none:#9C998F;--none-bg:#2C2B28;--none-bd:#45433E;
--badge-ink:#1F1E1D;color-scheme:dark;
}}
:root[data-theme=dark]{
--bg:#1F1E1D;--surface:#2A2927;--text:#ECEAE4;--muted:#A8A59C;--border:#3A3935;--accent:#D97757;--accent-ink:#1F1E1D;--code-bg:#242321;
--crit:#F2A08F;--crit-bg:#3B221D;--crit-bd:#6B3A30;
--warn:#E9C06B;--warn-bg:#372C17;--warn-bd:#66522A;
--ok:#97CE9F;--ok-bg:#1F3124;--ok-bd:#3A5A40;
--info:#A7C2DC;--info-bg:#1F2B37;--info-bd:#3B5268;
--none:#9C998F;--none-bg:#2C2B28;--none-bd:#45433E;
--badge-ink:#1F1E1D;color-scheme:dark;
}
html[data-lang=vi] [lang=en],html[data-lang=en] [lang=vi]{display:none!important}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--text);font:15px/1.55 var(--sans);-webkit-print-color-adjust:exact;print-color-adjust:exact}
.c-crit{--c:var(--crit);--cb:var(--crit-bg);--cd:var(--crit-bd)}
.c-warn{--c:var(--warn);--cb:var(--warn-bg);--cd:var(--warn-bd)}
.c-ok{--c:var(--ok);--cb:var(--ok-bg);--cd:var(--ok-bd)}
.c-info{--c:var(--info);--cb:var(--info-bg);--cd:var(--info-bd)}
.c-none{--c:var(--none);--cb:var(--none-bg);--cd:var(--none-bd)}
.wrap{max-width:1000px;margin:0 auto;padding:20px 20px 40px}
h1,h2,h3{font-family:var(--serif);font-weight:600;line-height:1.25;margin:0}
a{color:var(--accent);text-underline-offset:2px}
code,pre{font-family:var(--mono);font-size:.86em}
.top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:2px 0 14px;border-bottom:1px solid var(--border);margin-bottom:20px}
.brand{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.brand .logo{color:var(--accent);font-size:15px}
.brand .name{font-family:var(--serif);font-size:22px;font-weight:600}
.brand .sub{color:var(--muted);font-size:14px}
.ctl{display:flex;gap:8px;align-items:center}
.seg{display:inline-flex;border:1px solid var(--border);border-radius:8px;overflow:hidden}
.seg button,.iconbtn,.btn{font:inherit;font-size:13px;line-height:1.4;color:var(--text);background:var(--surface);border:0;padding:5px 11px;cursor:pointer}
.seg button+button{border-left:1px solid var(--border)}
.seg button[aria-pressed=true]{background:var(--accent);color:var(--accent-ink)}
.iconbtn,.btn{border:1px solid var(--border);border-radius:8px}
.btn{white-space:nowrap}
.iconbtn:hover,.btn:hover{border-color:var(--accent)}
.btn .done{display:none}.btn.is-done .lbl{display:none}.btn.is-done .done{display:inline;color:var(--ok)}
button:focus-visible,a:focus-visible,summary:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:18px 20px}
.ident h1{font-size:28px;overflow-wrap:anywhere}
.hostsub{color:var(--muted);margin-top:2px}
.kv{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px 22px;margin:14px 0 0}
.kv div{min-width:0}
.kv dt{font-size:11.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
.kv dd{margin:1px 0 0;overflow-wrap:anywhere}
.verdict{display:flex;gap:16px;align-items:center;margin:18px 0 0;padding:18px 20px;border-radius:14px;background:var(--cb);border:1px solid var(--cd);border-left:6px solid var(--c)}
.verdict h2{font-size:26px;color:var(--c);letter-spacing:.01em}
.vsub{margin:4px 0 0}
.badge{display:inline-flex;align-items:center;justify-content:center;flex:none;width:22px;height:22px;border-radius:50%;background:var(--c);color:var(--badge-ink);font:700 13px/1 var(--sans)}
.badge.lg{width:44px;height:44px;font-size:24px}
.badge.sm{width:18px;height:18px;font-size:11px}
section{margin:30px 0}
h2.sec{font-size:20px;margin-bottom:12px;display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
h2.sec small{font:400 13px var(--sans);color:var(--muted)}
.count{font:600 12px/1.5 var(--sans);color:var(--muted);background:var(--surface);border:1px solid var(--border);border-radius:999px;padding:0 8px}
.tiles{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(175px,1fr));gap:10px}
.tile>a,.tile>div{display:grid;grid-template-columns:auto 1fr;column-gap:10px;align-items:center;height:100%;padding:11px 12px;border-radius:12px;border:1px solid var(--border);background:var(--surface);color:inherit;text-decoration:none}
.tile>a:hover{border-color:var(--c)}
.tile.c-crit>*,.tile.c-warn>*{background:var(--cb);border-color:var(--cd)}
.tile .badge{grid-row:1/3}
.tname{font-weight:600;font-size:14px;line-height:1.3}
.tstat{font-size:12.5px;color:var(--muted)}
.tile.c-crit .tstat,.tile.c-warn .tstat{color:var(--c)}
.tile.c-none .tname{color:var(--muted);font-weight:500}
.todo{list-style:none;margin:0;padding:0}
.todo li{display:flex;gap:12px;align-items:flex-start;padding:12px 14px;border:1px solid var(--border);border-left:4px solid var(--c);border-radius:10px;background:var(--surface);margin-bottom:8px}
.todo li>div{min-width:0}
.todo-t{font-weight:600;color:var(--text);text-decoration:none}
.todo-t:hover{text-decoration:underline}
.todo p{margin:4px 0 0;white-space:pre-line}
.finding{border:1px solid var(--border);border-left:4px solid var(--c);border-radius:12px;background:var(--surface);padding:14px 16px;margin-bottom:12px;scroll-margin-top:12px}
.finding:target{box-shadow:0 0 0 3px var(--cd)}
.fh{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:13px;color:var(--muted)}
.chip{font-weight:600;color:var(--c);background:var(--cb);border:1px solid var(--cd);border-radius:999px;padding:0 9px}
.tgt{background:var(--code-bg);border-radius:6px;padding:1px 6px;color:var(--text);overflow-wrap:anywhere}
.finding h3{font-size:18px;margin:8px 0 4px;overflow-wrap:anywhere}
.detail p{margin:4px 0;white-space:pre-line;overflow-wrap:anywhere}
.action{margin-top:10px;padding:10px 12px;border-radius:8px;background:var(--bg);border:1px solid var(--border)}
.alabel{font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--accent)}
.action p{margin:2px 0 0;white-space:pre-line;overflow-wrap:anywhere}
.fpart{margin-top:8px;font-size:13px;color:var(--muted);overflow-wrap:anywhere}
.ev{margin-top:10px}
summary{cursor:pointer;color:var(--muted);font-size:13px}
pre{background:var(--code-bg);border:1px solid var(--border);border-radius:8px;padding:10px 12px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;margin:6px 0 0;line-height:1.45}
.fid{margin-top:6px;font:11px var(--mono);color:var(--muted);text-align:right;overflow-wrap:anywhere}
.ok-msg{color:var(--ok)}
h3.sub{font-size:16px;margin:20px 0 8px;display:flex;align-items:center;gap:8px}
.oklist{list-style:none;padding:0;margin:0;columns:2 320px;column-gap:28px}
.oklist li{display:flex;gap:8px;align-items:flex-start;break-inside:avoid;padding:3px 0}
.oklist .badge{margin-top:3px}
.sec-row{display:flex;justify-content:space-between;align-items:baseline;gap:12px;flex-wrap:wrap}
.tablewrap{overflow-x:auto;border:1px solid var(--border);border-radius:10px;background:var(--surface)}
table{border-collapse:collapse;width:100%;font-size:13.5px}
th,td{text-align:left;vertical-align:top;padding:7px 10px;border-bottom:1px solid var(--border)}
th{white-space:nowrap;font-weight:600;color:var(--muted);font-size:11.5px;text-transform:uppercase;letter-spacing:.03em;background:var(--bg)}
tbody tr:last-child td{border-bottom:0}
td{overflow-wrap:break-word}
table.data td{max-width:340px}
tr.c-crit td,tr.c-warn td{background:var(--cb)}
td.st,th.st{width:1%;padding-right:0}
td.st::before{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;border-radius:50%;background:var(--c);color:var(--badge-ink);font:700 11px/1 var(--sans)}
tr.c-crit td.st::before{content:"\2715"}tr.c-warn td.st::before{content:"!"}tr.c-ok td.st::before{content:"\2713"}tr.c-info td.st::before{content:"i"}tr.c-none td.st::before{content:"\2013"}
.tbl{margin-bottom:16px}
.tbl>summary{font:600 15px var(--serif);color:var(--text);margin-bottom:8px}
.tnote p{margin:6px 0 0;font-size:13px;color:var(--muted)}
.cov{list-style:none;margin:0 0 6px;padding:0}
.cov li{padding:10px 12px;border:1px solid var(--border);border-radius:10px;background:var(--surface);margin-bottom:8px}
.cname{font-weight:600;overflow-wrap:anywhere}
.creason{color:var(--muted);font-size:14px}
.cfix{margin-top:6px;font-size:14px}
.cmd{display:flex;gap:8px;align-items:stretch;margin-top:6px}
.cmd code{flex:1;min-width:0;background:var(--code-bg);border:1px solid var(--border);border-radius:8px;padding:6px 10px;overflow-x:auto;white-space:pre}
.ran>summary{font-size:14px}
.ranlist{columns:2 260px;font-size:14px;color:var(--muted);margin:8px 0 0}
.notes{margin:0;padding-left:20px}
.notes li{margin:4px 0}
.muted{color:var(--muted)}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.foot{margin-top:36px;padding-top:14px;border-top:1px solid var(--border);font-size:13px;color:var(--muted);display:flex;flex-wrap:wrap;gap:6px 18px;justify-content:space-between}
@media (max-width:640px){
.wrap{padding:14px 14px 32px}
.ident h1{font-size:23px}
.card{padding:14px}
.verdict{padding:14px;gap:12px}
.verdict h2{font-size:21px}
.badge.lg{width:36px;height:36px;font-size:19px}
.tiles{grid-template-columns:repeat(auto-fill,minmax(140px,1fr))}
.kv{grid-template-columns:1fr 1fr}
table.parts thead{display:none}
table.parts,table.parts tbody,table.parts tr,table.parts td{display:block;width:100%}
table.parts tr{padding:8px 0;border-bottom:1px solid var(--border)}
table.parts tbody tr:last-child{border-bottom:0}
table.parts td{border:0;padding:2px 12px;overflow-wrap:anywhere}
table.parts td.pk{font-weight:600;padding-bottom:4px}
table.parts td:empty{display:none}
html[data-lang=vi] table.parts td[data-vi]::before{content:attr(data-vi) ": "}
html[data-lang=en] table.parts td[data-en]::before{content:attr(data-en) ": "}
table.parts td::before{color:var(--muted);font-size:12.5px}
}
@page{size:A4;margin:14mm 12mm}
@media print{
html:root[data-lang]{
--bg:#FFFFFF;--surface:#FAF9F5;--text:#1F1E1D;--muted:#5E5D58;--border:#DDDBD0;--accent:#A84F32;--code-bg:#F3F2EC;
--crit:#B3261E;--crit-bg:#FBECE8;--crit-bd:#EDC2B9;
--warn:#8F5B00;--warn-bg:#FBF1DC;--warn-bd:#EBD39F;
--ok:#2F6B3F;--ok-bg:#E9F2E7;--ok-bd:#C3DABF;
--info:#3D5D7C;--info-bg:#E9EFF5;--info-bd:#C5D3E1;
--none:#7A7871;--none-bg:#EFEEE8;--none-bd:#DDDBD2;
--badge-ink:#FFFFFF;color-scheme:light;
}
body{font-size:10pt;background:#fff}
.noprint{display:none!important}
.wrap{max-width:none;padding:0}
section{margin:14px 0}
h2.sec{break-after:avoid}
.finding,.todo li,.tile,.cov li,tr,.verdict,.ident{break-inside:avoid}
.tablewrap{overflow:visible}
table.data td{max-width:none}
a{color:inherit;text-decoration:none}
pre,.cmd code{white-space:pre-wrap;overflow:visible}
.finding:target{box-shadow:none}
}
</style>
</head>
<body>
<div class="wrap">
<header class="top">
<div class="brand"><span class="logo" aria-hidden="true">&#9670;</span><span class="name">Diagward</span><span class="sub">{{template "t" .Title}}</span></div>
<div class="ctl noprint">
<div class="seg" role="group" aria-label="Ngôn ngữ / Language">
<button type="button" data-setlang="vi" aria-pressed="{{if eq .Lang "vi"}}true{{else}}false{{end}}">VI</button><button type="button" data-setlang="en" aria-pressed="{{if eq .Lang "en"}}true{{else}}false{{end}}">EN</button>
</div>
<button type="button" class="iconbtn" data-theme-toggle aria-label="Sáng / tối · Light / dark" title="Sáng / tối · Light / dark">&#9680;</button>
</div>
</header>

<main>
<section class="card ident" style="margin-top:0">
<h1>{{.Host}}</h1>{{with .HostSub}}<div class="hostsub">{{.}}</div>{{end}}
<dl class="kv">{{range .Identity}}
<div><dt>{{template "t" .Key}}</dt><dd>{{template "t" .Val}}</dd></div>{{end}}
</dl>
</section>

<section class="verdict c-{{.Class}}" role="status">
<span class="badge lg" aria-hidden="true">{{.Mark}}</span>
<div><h2>{{template "t" .Headline}}</h2><p class="vsub">{{template "t" .Sub}}</p></div>
</section>

<section aria-labelledby="h-comp">
<h2 class="sec" id="h-comp">{{template "t" (L "components")}}</h2>
<ul class="tiles">{{range .Components}}
<li class="tile c-{{.Class}}">{{if .Anchor}}<a href="#{{.Anchor}}">{{template "tile" .}}</a>{{else}}<div>{{template "tile" .}}</div>{{end}}</li>{{end}}
</ul>
</section>

<section aria-labelledby="h-now">
<h2 class="sec" id="h-now">{{template "t" (L "doNow")}}{{if .DoNow}} <span class="count">{{len .DoNow}}</span>{{end}}</h2>
{{if .DoNow}}<ol class="todo">{{range .DoNow}}
<li class="c-{{.Class}}"><span class="badge" aria-hidden="true">{{.Mark}}</span><div><a class="todo-t" href="#{{.Anchor}}">{{template "t" .Title}}</a>{{if .Action.EN}}{{template "p" .Action}}{{end}}</div></li>{{end}}
</ol>{{else}}<p class="muted">{{template "t" (L "doNowEmpty")}}</p>{{end}}
</section>

<section aria-labelledby="h-find">
<h2 class="sec" id="h-find">{{template "t" (L "findings")}} <span class="count">{{len .Findings}}</span></h2>
{{range .Findings}}
<article class="finding c-{{.Class}}" id="{{.Anchor}}">
<div class="fh"><span class="badge" aria-hidden="true">{{.Mark}}</span><span class="chip">{{template "t" .Sev}}</span>{{if .Comp.EN}}<span>{{template "t" .Comp}}</span>{{end}}{{with .Target}}<code class="tgt">{{.}}</code>{{end}}</div>
<h3>{{template "t" .Title}}</h3>
{{if .Detail.EN}}<div class="detail">{{template "p" .Detail}}</div>{{end}}
{{if .Action.EN}}<div class="action"><div class="alabel">{{template "t" (L "action")}}</div>{{template "p" .Action}}</div>{{end}}
{{with .Part}}<div class="fpart">{{.}}</div>{{end}}
{{if .Evidence}}<details class="ev"><summary>{{template "t" (L "evidence")}} ({{len .Evidence}})</summary><pre>{{range .Evidence}}{{.}}
{{end}}</pre></details>{{end}}
<div class="fid">{{.ID}}</div>
</article>
{{else}}<p class="ok-msg">{{template "t" (L "noFindings")}}</p>
{{end}}
{{if .OK}}<h3 class="sub">{{template "t" (L "okChecked")}} <span class="count">{{len .OK}}</span></h3>
<ul class="oklist c-ok">{{range .OK}}
<li><span class="badge sm" aria-hidden="true">✓</span><span>{{template "t" .Title}}</span></li>{{end}}
</ul>{{end}}
</section>
{{if .Parts}}
<section id="parts" aria-labelledby="h-parts">
<div class="sec-row"><h2 class="sec" id="h-parts">{{template "t" (L "parts")}} <small>{{template "t" (L "partsSub")}}</small></h2><button type="button" class="btn noprint" data-copy-rma>{{template "copylbl" (L "copyText")}}</button></div>
<div class="tablewrap"><table class="parts">
<thead><tr><th>{{template "t" (L "partKind")}}</th><th>{{template "t" (L "vendorModel")}}</th><th>{{template "t" (L "serial")}}</th><th>{{template "t" (L "location")}}</th><th>{{template "t" (L "why")}}</th></tr></thead>
<tbody>{{range .Parts}}
<tr class="c-{{.Class}}"><td class="pk"><span class="badge sm" aria-hidden="true">{{.Mark}}</span> {{template "t" .Kind}}</td><td data-vi="{{(L "vendorModel").VI}}" data-en="{{(L "vendorModel").EN}}">{{.Model}}{{with .Firmware}}<div class="muted">FW {{.}}</div>{{end}}</td><td data-vi="{{(L "serial").VI}}" data-en="{{(L "serial").EN}}">{{with .Serial}}<code>{{.}}</code>{{end}}</td><td data-vi="{{(L "location").VI}}" data-en="{{(L "location").EN}}">{{.Location}}</td><td data-vi="{{(L "why").VI}}" data-en="{{(L "why").EN}}">{{if .Anchor}}<a href="#{{.Anchor}}">{{template "t" .Why}}</a>{{else}}{{template "t" .Why}}{{end}}</td></tr>{{end}}
</tbody></table></div>
<pre id="rma-vi" lang="vi" hidden>{{.RMA.VI}}</pre>
<pre id="rma-en" lang="en" hidden>{{.RMA.EN}}</pre>
</section>
{{end}}
{{if .Tables}}
<section aria-labelledby="h-tables">
<h2 class="sec" id="h-tables">{{template "t" (L "tables")}}</h2>
{{range .Tables}}<details class="tbl" open>
<summary>{{template "t" .Title}} <span class="count">{{.Count}}</span></summary>
<div class="tablewrap"><table class="data">
<thead><tr><th class="st"><span class="sr">{{template "t" (L "status")}}</span></th>{{range .Columns}}<th>{{template "t" .}}</th>{{end}}</tr></thead>
<tbody>{{range .Rows}}
<tr class="c-{{.Class}}"><td class="st"></td>{{range .Cells}}<td>{{.}}</td>{{end}}</tr>{{end}}
</tbody></table></div>
{{if .Note.EN}}<div class="tnote">{{template "p" .Note}}</div>{{end}}
</details>
{{end}}
</section>
{{end}}
<section id="coverage" aria-labelledby="h-cov">
<h2 class="sec" id="h-cov">{{template "t" (L "coverage")}}</h2>
{{range .Coverage}}<h3 class="sub c-{{.Class}}"><span class="badge sm" aria-hidden="true">{{if eq .State "failed"}}!{{else if eq .State "partial"}}&#9680;{{else}}–{{end}}</span>{{template "t" .Title}} <span class="count">{{len .Items}}</span></h3>
<ul class="cov">{{range .Items}}
<li><div class="cname">{{template "t" .Names}}</div>{{if .Reason.EN}}<div class="creason">{{template "t" .Reason}}</div>{{end}}{{if .HasFix}}<div class="cfix" lang="vi">{{template "fix" .FixVI}}</div><div class="cfix" lang="en">{{template "fix" .FixEN}}</div>{{end}}</li>{{end}}
</ul>
{{end}}
{{if .Ran}}<details class="ran"><summary>{{template "t" (L "covRan")}} <span class="count">{{len .Ran}}</span></summary>
<ul class="ranlist">{{range .Ran}}<li>{{template "t" .}}</li>{{end}}</ul>
</details>{{end}}
{{if not (or .Coverage .Ran)}}<p class="muted">{{template "t" (L "none")}}</p>{{end}}
</section>
{{if .Notes}}
<section aria-labelledby="h-notes">
<h2 class="sec" id="h-notes">{{template "t" (L "notes")}}</h2>
<ul class="notes">{{range .Notes}}<li>{{template "t" .}}</li>{{end}}</ul>
</section>
{{end}}
</main>

<footer class="foot">
<div>{{template "t" (L "generated")}} <a href="{{.Repo}}">Diagward{{with .Version}} {{.}}{{end}}</a></div>
<div>{{if .Collected}}{{template "t" (L "collected")}}: {{.Collected}}{{end}}{{if .Duration.EN}} · {{template "t" (L "duration")}}: {{template "t" .Duration}}{{end}}</div>
<div>{{.Repo}}</div>
</footer>
</div>
<script>
(function () {
  var root = document.documentElement;
  function all(sel) { return document.querySelectorAll(sel); }
  function setLang(l) {
    if (l !== "vi" && l !== "en") { l = "vi"; }
    root.setAttribute("data-lang", l);
    root.setAttribute("lang", l);
    var b = all("[data-setlang]");
    for (var i = 0; i < b.length; i++) {
      b[i].setAttribute("aria-pressed", b[i].getAttribute("data-setlang") === l ? "true" : "false");
    }
    var t = root.getAttribute("data-title-" + l);
    if (t) { document.title = t; }
  }
  function up(el, attr) {
    while (el && el.nodeType === 1) {
      if (el.hasAttribute(attr)) { return el; }
      el = el.parentNode;
    }
    return null;
  }
  function flash(btn) {
    btn.classList.add("is-done");
    setTimeout(function () { btn.classList.remove("is-done"); }, 1600);
  }
  function copy(text, btn) {
    function fallback() {
      var ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.position = "fixed";
      ta.style.top = "-1000px";
      document.body.appendChild(ta);
      ta.select();
      var ok = false;
      try { ok = document.execCommand("copy"); } catch (e) { ok = false; }
      document.body.removeChild(ta);
      if (ok) { flash(btn); }
    }
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text).then(function () { flash(btn); }, fallback);
    } else {
      fallback();
    }
  }
  document.addEventListener("click", function (e) {
    var b;
    if ((b = up(e.target, "data-setlang"))) { setLang(b.getAttribute("data-setlang")); return; }
    if ((b = up(e.target, "data-theme-toggle"))) {
      var cur = root.getAttribute("data-theme");
      if (!cur) { cur = (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches) ? "dark" : "light"; }
      var next = cur === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      try { localStorage.setItem("dw-theme", next); } catch (x) {}
      return;
    }
    if ((b = up(e.target, "data-copy-rma"))) {
      var pre = document.getElementById("rma-" + (root.getAttribute("data-lang") || "vi"));
      if (pre) { copy(pre.textContent, b); }
      return;
    }
    if ((b = up(e.target, "data-copy-cmd"))) {
      var code = b.parentNode.getElementsByTagName("code")[0];
      if (code) { copy(code.textContent, b); }
    }
  });
  var reopened = [];
  window.addEventListener("beforeprint", function () {
    var d = all("details");
    reopened = [];
    for (var i = 0; i < d.length; i++) {
      if (!d[i].open) { d[i].open = true; reopened.push(d[i]); }
    }
  });
  window.addEventListener("afterprint", function () {
    for (var i = 0; i < reopened.length; i++) { reopened[i].open = false; }
    reopened = [];
  });
  setLang(root.getAttribute("data-lang"));
})();
</script>
</body>
</html>
